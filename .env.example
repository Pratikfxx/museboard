# Browser-safe Supabase values. Set both to enable production sign-up/sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key for webhook/admin projections only.
# Never prefix this value with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SECRET_KEY=

# Stripe server configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Canonical HTTPS origin used for auth callbacks and Stripe return URLs.
NEXT_PUBLIC_APP_URL=

# Independent safe-off switches (true/false)
FEATURE_STRATEGIST=true
FEATURE_LIVE_BILLING=true
FEATURE_COLLABORATION=true
FEATURE_ANALYTICS_IMPORT=true
FEATURE_3D=true
