# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Stripe server configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Must be the canonical HTTPS origin in configured billing mode
NEXT_PUBLIC_APP_URL=

# Independent safe-off switches (true/false)
FEATURE_STRATEGIST=true
FEATURE_LIVE_BILLING=true
FEATURE_COLLABORATION=true
FEATURE_ANALYTICS_IMPORT=true
FEATURE_3D=true
